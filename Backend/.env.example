# Copy to Backend/.env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------
# Qdrant Cloud cluster URL (or http://localhost:6333). Use ":memory:" for an
# ephemeral in-process store while developing (data is lost on restart).
QDRANT_URL=https://YOUR-CLUSTER.qdrant.io:6333
QDRANT_API_KEY=
GEMINI_API_KEY=

# --- Optional ---------------------------------------------------------------
# GEMINI_MODEL=gemini-2.5-flash
# QDRANT_COLLECTION=visrag_multimodal_v2

# Comma-separated browser origins allowed to call the API (CORS).
# ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# If set, every request must send an `X-API-Key` header with this value.
# (A key baked into a browser bundle is NOT secret; use this for server-to-server
# use or behind a proxy.)
# API_KEY=

# Per-IP requests per minute (0 disables).
# RATE_LIMIT_UPLOAD_PER_MIN=5
# RATE_LIMIT_ASK_PER_MIN=30

# MAX_UPLOAD_MB=25
# MAX_CONCURRENT_INGESTIONS=2
# MAX_TABLE_PAGES=100
# MAX_FIGURES=200
