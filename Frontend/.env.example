# Copy to Frontend/.env.local (git-ignored via *.local) to override defaults.

# Where the backend API lives. Defaults to http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# Only needed if the backend sets API_KEY. NOTE: anything in VITE_* is bundled
# into the browser code and visible to every visitor, so this is not a secret.
# VITE_API_KEY=
